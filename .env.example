# Optional. The app already defaults to the production API in src/config.ts,
# so you only need this to point at a different backend.
#
# EXPO_PUBLIC_* vars are inlined at BUILD time. For Netlify, set this in the
# dashboard (Site settings → Environment variables) — a committed .env is
# gitignored and won't be deployed. Copy to `.env` only for LOCAL builds.

EXPO_PUBLIC_API_URL=https://urban-lift-api.onrender.com
